# Atlas backend environment.
#
# Copy this file to atlas/.env and edit. The Makefile auto-loads it via
# `-include .env`; docker-compose.yml reads the same variables.

# ---------------------------------------------------------------------------
# LLM endpoint — used by department extraction, alias expansion, and the
# Street View / photo edge-walker. Same conventions as training/.env: any
# OpenAI-compatible endpoint works (Ollama, llama-swap, vLLM, OpenAI's API).
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3.5-122b
OPENAI_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Optional: Google Maps API key for the Street View edge-walker.
# Without this, /streetview-edges endpoints return 400.
# ---------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Optional: GitHub OAuth — only needed for public deploys that want
# role-based auth gates. Leave unset for local dev (auth is off by default).
# Roles are configured in atlas/data/roles.yaml.
# ---------------------------------------------------------------------------
# ATLAS_AUTH_ENABLED=true
# ATLAS_GITHUB_OAUTH_CLIENT_ID=
# ATLAS_GITHUB_OAUTH_CLIENT_SECRET=
# ATLAS_SESSION_SECRET=<long-random-string>

# ---------------------------------------------------------------------------
# Optional: Redis-backed job runner (for multi-replica deploys). When unset,
# atlas uses an in-memory job store (single backend replica only).
# ---------------------------------------------------------------------------
# ATLAS_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Optional: rate limiting (off by default in dev). Limits are read from
# the env via ATLAS_RATE_LIMIT_* — see backend/app/rate_limits.py.
# ---------------------------------------------------------------------------
# ATLAS_RATE_LIMIT_ENABLED=true
