# Training pipeline environment.
#
# Copy this file to training/.env and edit the values. The Makefile and the
# Python scripts both read it via python-dotenv (see config.py).
#
# All three logical endpoints (target, teacher, judge) currently share the
# SAME API key — set OPENAI_API_KEY once and it applies everywhere. If you
# need per-endpoint keys (e.g. judge on OpenAI, teacher on a private host),
# extend config.py.get_client() to accept an api_key argument.

# ---------------------------------------------------------------------------
# Target model — the small model being trained/evaluated. Used by eval_runner
# directly. For local Ollama, OPENAI_API_KEY can be any non-empty string.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=medical-wayfinder-gemma-4-e2b
OPENAI_API_KEY=not-needed

# ---------------------------------------------------------------------------
# Teacher and judge endpoints (used by `make generate`, `make score`, etc.).
# These are also Makefile variables — values here become the defaults; pass
# `make generate TEACHER_ENDPOINT=...` to override per-run.
#
# In dev these typically point at a stronger model on a remote box. For a
# pure-local setup, leave them as the localhost defaults below.
# ---------------------------------------------------------------------------
TEACHER_MODEL=qwen3.5-122b
TEACHER_ENDPOINT=http://localhost:11434/v1

JUDGE_MODEL=gemma4-31b
JUDGE_ENDPOINT=http://localhost:11434/v1

# Concurrency knobs — match these to your endpoint's slot counts.
# CONCURRENCY=3
# JUDGE_CONCURRENCY=3
