# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Models — ignore everything except the symlink to the in-repo stub,
# which the Flutter asset bundler needs to find at build/test time on
# fresh checkouts (real weights are fetched per model/INSTRUCTIONS.md).
assets/models/*
!assets/models/model.gguf

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Bundled on-device model (symlink → ../../model/model.litertlm)
assets/models/*.litertlm

ios/Frameworks/
